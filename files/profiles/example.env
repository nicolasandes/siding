# siding profile — one workspace and the GitHub identity that belongs to it.
# Create these with: siding profile add <name> --root <dir> --gh <acct> --email <addr> --wire
WS_ROOT="$HOME/dev/myworkspace"   # directory holding your checkouts
WS_NAME="work"                    # tmux session name
WS_GH="my-work-account"           # gh switches to this when you enter
WS_EMAIL="me@company.com"         # what git should be using here
WS_SSH_HOST="github.com"          # SSH host alias remotes must resolve to
